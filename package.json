{
  "name": "aep-outage-prediction",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "bun --watch index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun index.ts",
    "typecheck": "tsc --noEmit",
    "data:pull": "bash scripts/download-data.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.70",
    "@ai-sdk/react": "^4.0.157",
    "ai": "^7.0.153",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
