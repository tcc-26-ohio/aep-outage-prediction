{
  "name": "aep-outage-prediction",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "vite",
    "dev:api": ".venv/bin/python -m uvicorn app.main:app --app-dir backend --reload",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:pull": "bash scripts/download-data.sh",
    "weather:pull": ".venv/bin/python scripts/download_weather.py"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
